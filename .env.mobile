# Mobile APK default: use the built-in local question generator instead of a missing /api route inside WebView.
# To use real AI in a phone build, set VITE_ENABLE_REAL_AI=true and provide a hosted endpoint, e.g. your Vercel API URL.
VITE_ENABLE_REAL_AI=false
VITE_AI_REQUEST_TIMEOUT_MS=8000
# VITE_AI_QUESTION_ENDPOINT=https://your-domain.vercel.app/api/generate-ai-question
