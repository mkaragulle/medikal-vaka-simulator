{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --package-lock=false --legacy-peer-deps --no-audit --no-fund",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/generate-ai-question.js": { "maxDuration": 60 },
    "api/generate-lesson.js": { "maxDuration": 60 },
    "api/analyze-uploaded-material.js": { "maxDuration": 60 },
    "api/generate-material-questions.js": { "maxDuration": 60 },
    "api/generate-material-flashcards.js": { "maxDuration": 60 },
    "api/validate-ai-output.js": { "maxDuration": 60 }
  }
}
