# Shared provider settings. Never expose server keys with VITE_.
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# TUS mode: keep fast and short.
TUS_OPENAI_API_KEY=your_openai_api_key_here
TUS_OPENAI_MODEL=your_fast_question_model
TUS_OPENAI_BASE_URL=https://api.openai.com/v1
TUS_OPENAI_API_STYLE=chat
TUS_OPENAI_MAX_OUTPUT_TOKENS=1800
TUS_OPENAI_PER_REQUEST_TIMEOUT_MS=25000
REMOTE_AI_ATTEMPTS=2
AI_ENABLE_SAFE_FALLBACK=true

# KOMITE mode: separate from TUS because uploaded document summaries need more time and output tokens.
KOMITE_OPENAI_API_KEY=your_openai_api_key_here
KOMITE_OPENAI_MODEL=your_document_summary_model
KOMITE_OPENAI_BASE_URL=https://api.openai.com/v1
KOMITE_AI_TIMEOUT_MS=240000
KOMITE_MAX_SOURCE_CHARS=16000
KOMITE_LESSON_MAX_OUTPUT_TOKENS=4800
KOMITE_QUESTIONS_MAX_SOURCE_CHARS=14000
KOMITE_QUESTIONS_MAX_OUTPUT_TOKENS=4200
KOMITE_FLASHCARDS_MAX_SOURCE_CHARS=12000
KOMITE_FLASHCARDS_MAX_OUTPUT_TOKENS=3200
KOMITE_ANALYSIS_MAX_SOURCE_CHARS=10000
KOMITE_ANALYSIS_MAX_OUTPUT_TOKENS=1800

# Backward-compatible defaults. The app uses these only if TUS_/KOMITE_ values are missing.
OPENAI_MODEL=your_default_model
DEFAULT_GENERATOR_MODEL=your_default_model
OPENAI_API_STYLE=chat
OPENAI_MAX_OUTPUT_TOKENS=1800
OPENAI_PER_REQUEST_TIMEOUT_MS=25000

# Frontend AI endpoint
VITE_ENABLE_REAL_AI=true
VITE_AI_QUESTION_ENDPOINT=/api/generate-ai-question
VITE_AI_REQUEST_TIMEOUT_MS=45000
VITE_AI_REMOTE_RETRY_COUNT=1
VITE_AI_ENABLE_CLIENT_FALLBACK=true

# Upload and validation controls
AI_VALIDATION_ENABLED=false
AI_RETRY_LIMIT=0
MAX_UPLOAD_MB=20
