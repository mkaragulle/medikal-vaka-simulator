# Firebase Authentication / Google Sign-In
# Bu dosyada gerçek secret tutma. Lokal kullanım için .env.local oluştur.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# --- KlinikIQ AI üretim stratejisi ---
# Production önerisi: free modeli tek başına güven motoru yapma. Free/OpenRouter profili test ve düşük riskli denemeler için uygundur;
# final kullanıcıya çıkmadan önce deterministic medical gate + JSON schema + duplicate/leakage gate zorunludur.
AI_PROVIDER=openrouter
DEFAULT_GENERATOR_MODEL=google/gemini-2.5-flash-lite
HIGH_ACCURACY_VALIDATOR_MODEL=
CHEAP_DRAFT_MODEL=openai/gpt-oss-120b:free
POLISHER_MODEL=
JSON_REPAIR_MODEL=
AI_DEBUG_USAGE_LOGS=false
AI_ESTIMATED_COST_PER_1K_TOKENS_USD=

# --- AI ile Soru Üret / OpenRouter entegrasyonu ---
# Server-side secret. Vercel'e OPENROUTER_API_KEY adıyla ekle; VITE_ prefix kullanma.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://medikal-vaka-simulator-yl76.vercel.app
OPENROUTER_APP_TITLE=KlinikIQ

# Free model modu: geliştirme/test için. Production'da false yapıp DEFAULT_GENERATOR_MODEL/OPENROUTER_MODEL kullan.
OPENROUTER_FREE_MODEL_MODE=true
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_MODELS=openai/gpt-oss-120b:free
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_MAX_MODEL_ATTEMPTS=1

# Free modellerde tam şema istemiyoruz; kısa JSON alınıp server'da KlinikIQ şemasına tamamlanıyor.
OPENROUTER_MAX_TOKENS=850
OPENROUTER_COMPACT_ON_402=true
OPENROUTER_COMPACT_MAX_TOKENS=750
OPENROUTER_PER_MODEL_TIMEOUT_MS=52000
OPENROUTER_ALLOW_SLOW_MODELS=true
OPENROUTER_BLOCKED_MODELS=
OPENROUTER_REPAIR_JSON_ON_PARSE_ERROR=true
OPENROUTER_REPAIR_MODEL=
OPENROUTER_REPAIR_MAX_TOKENS=1000
OPENROUTER_TEMPERATURE=0.35
OPENROUTER_TOP_P=0.75
OPENROUTER_USE_JSON_MODE=true
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_REASONING_EXCLUDE=true

# Frontend gerçek AI endpoint ayarları.
VITE_ENABLE_REAL_AI=true
VITE_AI_QUESTION_ENDPOINT=/api/generate-ai-question
VITE_AI_REQUEST_TIMEOUT_MS=90000
VITE_AI_REMOTE_RETRY_COUNT=1

# --- İsteğe bağlı alternatif sağlayıcılar ---
# OPENAI_API_KEY=server-side-only
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_OUTPUT_TOKENS=2600
# GEMINI_API_KEY=server-side-only
# GEMINI_MODEL=

# Server-side retry. Validation/schema/scientific gate failure olursa endpoint yeniden remote dener.
REMOTE_AI_ATTEMPTS=2
