# Firebase Authentication / Google Sign-In
# Bu dosyada gerçek secret tutma. Lokal kullanım için .env.local oluştur.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# --- AI ile Soru Üret / gerçek AI entegrasyonu ---
# Varsayılan true: frontend önce gerçek AI endpointini dener; endpoint/API key yoksa local fallback çalışır.
VITE_ENABLE_REAL_AI=true
VITE_AI_QUESTION_ENDPOINT=/api/generate-ai-question
# OpenRouter free modeller bazen yavaş dönebilir; 30 sn timeout önerilir.
VITE_AI_REQUEST_TIMEOUT_MS=30000
# Gerçek AI validation/JSON nedeniyle hata verirse kaç kez tekrar denensin.
VITE_AI_REMOTE_RETRY_COUNT=2

# --- ÖNERİLEN SAĞLAYICI: OpenRouter ---
# Bu anahtar frontend'e konmamalıdır. Vercel Project Settings > Environment Variables kısmına eklenmelidir.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=server-side-only
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://your-vercel-domain.vercel.app
OPENROUTER_APP_TITLE=KlinikIQ
OPENROUTER_MAX_TOKENS=2800
OPENROUTER_TEMPERATURE=0.86
OPENROUTER_TOP_P=0.92
# JSON mode desteklemeyen model olursa endpoint otomatik json mode olmadan tekrar dener.
OPENROUTER_USE_JSON_MODE=true
# İsteğe bağlı: OpenRouter fallback model listesi. Virgülle ayır.
# OPENROUTER_MODELS=openai/gpt-oss-120b:free,openrouter/free
# İsteğe bağlı reasoning. JSON parse stabilitesi için varsayılan kapalı.
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_REASONING_EXCLUDE=true

# --- İsteğe bağlı alternatif sağlayıcılar ---
# OPENAI_API_KEY=server-side-only
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=server-side-only
# GEMINI_MODEL=gemini-1.5-flash
