# Firebase Authentication / Google Sign-In
# Bu dosyada gerçek secret tutma. Lokal kullanım için .env.local oluştur.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# --- AI ile Soru Üret / gerçek AI entegrasyonu ---
# Varsayılan true: frontend önce gerçek AI endpointini dener; endpoint/API key yoksa local fallback çalışır.
VITE_ENABLE_REAL_AI=true
# Vercel/serverless endpoint. Sadece local generator kullanmak istersen VITE_ENABLE_REAL_AI=false yap.
VITE_AI_QUESTION_ENDPOINT=/api/generate-ai-question
VITE_AI_REQUEST_TIMEOUT_MS=9000
# Aynı/benzer soru gelirse gerçek AI kaç kez yeniden denensin.
VITE_AI_REMOTE_RETRY_COUNT=3

# Bu anahtar frontend'e konmamalıdır. Vercel Project Settings > Environment Variables kısmına eklenmelidir.
# OPENAI_API_KEY=server-side-only
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=openai
# Alternatif sağlayıcı kullanmak istersen:
# GEMINI_API_KEY=server-side-only
# GEMINI_MODEL=gemini-1.5-flash
