# Firebase Authentication / Google Sign-In
# Bu dosyada gerçek secret tutma. Lokal kullanım için .env.local oluştur.
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# KlinikIQ AI Question Generation
# OpenAI anahtarını sadece server-side environment variable olarak Vercel'e ekle.
# Kesinlikle VITE_OPENAI_API_KEY kullanma ve gerçek key'i GitHub'a yükleme.
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
DEFAULT_GENERATOR_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_OUTPUT_TOKENS=2600
OPENAI_PER_REQUEST_TIMEOUT_MS=28000

# Remote üretim başarısız olursa kullanıcıya hata göstermek yerine doğrulanmış yerel TUS spot fallback döner.
AI_ENABLE_SAFE_FALLBACK=true
REMOTE_AI_ATTEMPTS=2
AI_DEBUG_USAGE_LOGS=false
AI_ESTIMATED_COST_PER_1K_TOKENS_USD=

# Frontend AI endpoint
VITE_ENABLE_REAL_AI=true
VITE_AI_QUESTION_ENDPOINT=/api/generate-ai-question
VITE_AI_REQUEST_TIMEOUT_MS=90000
VITE_AI_REMOTE_RETRY_COUNT=1

# Opsiyonel alternatif sağlayıcılar. Şimdilik boş bırakılabilir.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://medikal-vaka-simulator-yl76.vercel.app
OPENROUTER_APP_TITLE=KlinikIQ
OPENROUTER_FREE_MODEL_MODE=false
OPENROUTER_MODEL=
OPENROUTER_MODELS=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_MAX_MODEL_ATTEMPTS=1
OPENROUTER_MAX_TOKENS=850
OPENROUTER_COMPACT_ON_402=true
OPENROUTER_COMPACT_MAX_TOKENS=750
OPENROUTER_PER_MODEL_TIMEOUT_MS=52000
OPENROUTER_REPAIR_JSON_ON_PARSE_ERROR=true
OPENROUTER_TEMPERATURE=0.35
OPENROUTER_TOP_P=0.75
OPENROUTER_USE_JSON_MODE=true
OPENROUTER_REASONING_ENABLED=false
OPENROUTER_REASONING_EXCLUDE=true

GEMINI_API_KEY=
GEMINI_MODEL=
