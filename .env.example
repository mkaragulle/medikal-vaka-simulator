# Server-side OpenAI key. VITE_ prefix kullanma.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-nano
OPENAI_RESPONSE_FORMAT=json_schema
OPENAI_QUESTION_BATCH_SIZE=2
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.35
OPENAI_PROMPT_CACHE_KEY=klinikiq-tus-question-v9-title-and-wrong-list

# Firebase / Google giriş kullanılıyorsa doldur.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
